    {
      "id": "ndjson-malformed-line",
      "category": "malformed",
      "intent": "Emit ids of valid records; a malformed line is reported and fails the run.",
      "data": "fixtures/events-malformed.ndjson",
      "profile": "standard",
      "preferred": "either",
      "expect": {"lines": [1, 3], "status": "nonzero"},
      "jpx": {
        "args": ["--stream", "id"],
        "difference": "tolerant_streaming",
        "expect": {"lines": [1, 3], "status": 0, "stderr_contains": ["Failed to parse JSON"]}
      },
      "python": {"code": "bad=0\nfor l in open(P):\n if not l.strip():continue\n try:out(json.loads(l)['id'])\n except ValueError as e:bad=1;print(e,file=sys.stderr)\nsys.exit(bad)"},
      "js": {"code": "let bad=0;for(const l of fs.readFileSync(P,'utf8').split('\\n')){if(!l.trim())continue;try{out(JSON.parse(l).id)}catch(e){bad=1;console.error(e.message)}}process.exitCode=bad"}
    },
