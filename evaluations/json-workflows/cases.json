{
  "differences": {
    "null_omission": "Projections ([*].x) drop null results, so per-item alignment is lost; use map(&x, arr) to keep nulls.",
    "forgiving_json_decode": "json_decode returns null for invalid JSON instead of failing; a null result prints nothing and exits 0.",
    "tolerant_streaming": "--stream reports unparsable lines on stderr, skips them and still exits 0.",
    "chained_cli_expressions": "Repeated -e/positional expressions form a pipeline, not independent queries; combine them in one multiselect.",
    "false_null_exit_status": "-x fails only on false or null; an empty array or object is truthy for exit status."
  },
  "cases": [
    {
      "id": "ci-select",
      "category": "selection",
      "intent": "Pick run status, conclusion and commit from a CI run.",
      "data": "fixtures/ci-run.json",
      "profile": "standard",
      "preferred": "either",
      "expect": {"json": {"status": "completed", "conclusion": "failure", "sha": "a1b2c3d"}},
      "jpx": {"args": ["{status: status, conclusion: conclusion, sha: head_sha}"]},
      "python": {"code": "d=J();out({'status':d['status'],'conclusion':d['conclusion'],'sha':d['head_sha']})"},
      "js": {"code": "const d=J();out({status:d.status,conclusion:d.conclusion,sha:d.head_sha})"}
    },
    {
      "id": "ci-failed-jobs",
      "category": "filter",
      "intent": "Names of failed CI jobs.",
      "data": "fixtures/ci-run.json",
      "profile": "standard",
      "preferred": "jpx",
      "expect": {"json": ["test"]},
      "jpx": {"args": ["jobs[?conclusion == 'failure'].name"]},
      "python": {"code": "out([j['name'] for j in J()['jobs'] if j['conclusion']=='failure'])"},
      "js": {"code": "out(J().jobs.filter(j=>j.conclusion==='failure').map(j=>j.name))"}
    },
    {
      "id": "ci-summary",
      "category": "ci-summary",
      "intent": "Job count, failed and pending (null conclusion) job names, total seconds.",
      "data": "fixtures/ci-run.json",
      "profile": "standard",
      "preferred": "jpx",
      "expect": {"json": {"total": 4, "failed": ["test"], "pending": ["docs"], "seconds": 147}},
      "jpx": {"args": ["{total: length(jobs), failed: jobs[?conclusion == 'failure'].name, pending: jobs[?conclusion == `null`].name, seconds: sum(jobs[*].seconds)}"]},
      "python": {"code": "j=J()['jobs'];out({'total':len(j),'failed':[x['name'] for x in j if x['conclusion']=='failure'],'pending':[x['name'] for x in j if x['conclusion'] is None],'seconds':sum(x['seconds'] for x in j)})"},
      "js": {"code": "const j=J().jobs;out({total:j.length,failed:j.filter(x=>x.conclusion==='failure').map(x=>x.name),pending:j.filter(x=>x.conclusion===null).map(x=>x.name),seconds:j.reduce((a,x)=>a+x.seconds,0)})"}
    },
    {
      "id": "multiple-queries-combined",
      "category": "multiple-queries",
      "intent": "Answer two independent questions (failed count, slowest job) in one call.",
      "data": "fixtures/ci-run.json",
      "profile": "standard",
      "preferred": "jpx",
      "expect": {"json": {"failed": 1, "slowest": "test"}},
      "jpx": {"args": ["{failed: length(jobs[?conclusion == 'failure']), slowest: max_by(jobs, &seconds).name}"]},
      "python": {"code": "j=J()['jobs'];out({'failed':sum(x['conclusion']=='failure' for x in j),'slowest':max(j,key=lambda x:x['seconds'])['name']})"},
      "js": {"code": "const j=J().jobs;out({failed:j.filter(x=>x.conclusion==='failure').length,slowest:j.reduce((a,x)=>x.seconds>a.seconds?x:a).name})"}
    },
    {
      "id": "multiple-queries-chained-e",
      "category": "multiple-queries",
      "intent": "Status and conclusion as two independent queries in one call.",
      "data": "fixtures/ci-run.json",
      "profile": "standard",
      "preferred": "jpx",
      "expect": {"json": {"status": "completed", "conclusion": "failure"}},
      "jpx": {
        "args": ["-e", "status", "-e", "conclusion"],
        "difference": "chained_cli_expressions",
        "expect": {"status": 0},
        "note": "'conclusion' is evaluated against the string \"completed\", yields null and prints nothing; see multiple-queries-combined."
      },
      "python": {"code": "d=J();out({'status':d['status'],'conclusion':d['conclusion']})"},
      "js": {"code": "const d=J();out({status:d.status,conclusion:d.conclusion})"}
    },
    {
      "id": "filter-open-bugs",
      "category": "filter",
      "intent": "Numbers of open issues labelled bug.",
      "data": "fixtures/issues.json",
      "profile": "standard",
      "preferred": "jpx",
      "expect": {"json": [101, 103]},
      "jpx": {"args": ["issues[?state == 'open' && contains(labels, 'bug')].number"]},
      "python": {"code": "out([i['number'] for i in J()['issues'] if i['state']=='open' and 'bug' in i['labels']])"},
      "js": {"code": "out(J().issues.filter(i=>i.state==='open'&&i.labels.includes('bug')).map(i=>i.number))"}
    },
    {
      "id": "reshape-issues",
      "category": "reshape",
      "intent": "One {id, author, labels count} record per issue.",
      "data": "fixtures/issues.json",
      "profile": "standard",
      "preferred": "jpx",
      "expect": {"json": [
        {"id": 101, "author": "ada", "labels": 2},
        {"id": 102, "author": "lin", "labels": 1},
        {"id": 103, "author": "sam", "labels": 1},
        {"id": 104, "author": "ada", "labels": 1},
        {"id": 105, "author": "kim", "labels": 1}
      ]},
      "jpx": {"args": ["issues[*].{id: number, author: user.login, labels: length(labels)}"]},
      "python": {"code": "out([{'id':i['number'],'author':i['user']['login'],'labels':len(i['labels'])} for i in J()['issues']])"},
      "js": {"code": "out(J().issues.map(i=>({id:i.number,author:i.user.login,labels:i.labels.length})))"}
    },
    {
      "id": "count-by-state",
      "category": "count",
      "intent": "Issue count per state.",
      "data": "fixtures/issues.json",
      "profile": "extensions",
      "preferred": "jpx",
      "expect": {"json": {"open": 3, "closed": 2}},
      "jpx": {"args": ["count_by(&state, issues)"]},
      "python": {"code": "import collections;out(dict(collections.Counter(i['state'] for i in J()['issues'])))"},
      "js": {"code": "const c={};for(const i of J().issues)c[i.state]=(c[i.state]||0)+1;out(c)"}
    },
    {
      "id": "group-by-state",
      "category": "group",
      "intent": "Issue numbers grouped by state, groups sorted by state.",
      "data": "fixtures/issues.json",
      "profile": "extensions",
      "preferred": "jpx",
      "expect": {"json": [{"state": "closed", "numbers": [102, 104]}, {"state": "open", "numbers": [101, 103, 105]}]},
      "jpx": {"args": ["group_by(issues, &state) | items(@) | sort_by(@, &[0]) | [*].{state: [0], numbers: [1][*].number}"]},
      "python": {"code": "g={}\nfor i in J()['issues']:g.setdefault(i['state'],[]).append(i['number'])\nout([{'state':k,'numbers':g[k]} for k in sorted(g)])"},
      "js": {"code": "const g={};for(const i of J().issues)(g[i.state]??=[]).push(i.number);out(Object.keys(g).sort().map(k=>({state:k,numbers:g[k]})))"}
    },
    {
      "id": "no-match",
      "category": "no-match",
      "intent": "Filter that matches nothing returns an empty list, not an error.",
      "data": "fixtures/issues.json",
      "profile": "standard",
      "preferred": "jpx",
      "expect": {"json": []},
      "jpx": {"args": ["issues[?state == 'merged'].number"]},
      "python": {"code": "out([i['number'] for i in J()['issues'] if i['state']=='merged'])"},
      "js": {"code": "out(J().issues.filter(i=>i.state==='merged').map(i=>i.number))"}
    },
    {
      "id": "null-vs-missing",
      "category": "null-missing",
      "intent": "Distinguish an explicit null assignee from a missing assignee key.",
      "data": "fixtures/issues.json",
      "profile": "standard",
      "preferred": "either",
      "expect": {"json": [
        {"n": 101, "has_key": true, "assignee": null},
        {"n": 102, "has_key": true, "assignee": "ada"},
        {"n": 103, "has_key": false, "assignee": null},
        {"n": 104, "has_key": true, "assignee": "sam"},
        {"n": 105, "has_key": true, "assignee": "lin"}
      ]},
      "jpx": {"args": ["issues[*].{n: number, has_key: contains(keys(@), 'assignee'), assignee: assignee}"]},
      "python": {"code": "out([{'n':i['number'],'has_key':'assignee' in i,'assignee':i.get('assignee')} for i in J()['issues']])"},
      "js": {"code": "out(J().issues.map(i=>({n:i.number,has_key:'assignee' in i,assignee:i.assignee??null})))"}
    },
    {
      "id": "null-omission",
      "category": "null-missing",
      "intent": "One assignee slot per issue, null when unassigned.",
      "data": "fixtures/issues.json",
      "profile": "standard",
      "preferred": "jpx",
      "expect": {"json": [null, "ada", null, "sam", "lin"]},
      "jpx": {
        "args": ["issues[*].assignee"],
        "difference": "null_omission",
        "expect": {"json": ["ada", "sam", "lin"]}
      },
      "python": {"code": "out([i.get('assignee') for i in J()['issues']])"},
      "js": {"code": "out(J().issues.map(i=>i.assignee??null))"}
    },
    {
      "id": "null-preserving-map",
      "category": "null-missing",
      "intent": "One assignee slot per issue, null when unassigned (null-preserving translation).",
      "data": "fixtures/issues.json",
      "profile": "standard",
      "preferred": "jpx",
      "expect": {"json": [null, "ada", null, "sam", "lin"]},
      "jpx": {"args": ["map(&assignee, issues)"]},
      "python": {"code": "out([i.get('assignee') for i in J()['issues']])"},
      "js": {"code": "out(J().issues.map(i=>i.assignee??null))"}
    },
    {
      "id": "exit-status-empty-match",
      "category": "no-match",
      "intent": "Shell conditional: exit nonzero when no issue is merged.",
      "data": "fixtures/issues.json",
      "profile": "standard",
      "preferred": "jpx",
      "expect": {"json": [], "status": 1},
      "jpx": {
        "args": ["-x", "issues[?state == 'merged']"],
        "difference": "false_null_exit_status",
        "expect": {"json": [], "status": 0},
        "note": "Use a boolean expression instead; see exit-status-boolean."
      },
      "python": {"code": "m=[i for i in J()['issues'] if i['state']=='merged'];out(m);sys.exit(0 if m else 1)"},
      "js": {"code": "const m=J().issues.filter(i=>i.state==='merged');out(m);process.exitCode=m.length?0:1"}
    },
    {
      "id": "exit-status-boolean",
      "category": "no-match",
      "intent": "Shell conditional via a boolean: exit nonzero when no issue is merged.",
      "data": "fixtures/issues.json",
      "profile": "standard",
      "preferred": "jpx",
      "expect": {"json": false, "status": 1},
      "jpx": {"args": ["-x", "length(issues[?state == 'merged']) > `0`"]},
      "python": {"code": "m=any(i['state']=='merged' for i in J()['issues']);out(m);sys.exit(0 if m else 1)"},
      "js": {"code": "const m=J().issues.some(i=>i.state==='merged');out(m);process.exitCode=m?0:1"}
    },
    {
