    {
      "id": "large-id-roundtrip",
      "category": "large-id",
      "intent": "Project 64-bit order ids above 2^53 without losing precision.",
      "data": "fixtures/orders.json",
      "profile": "standard",
      "preferred": "jpx",
      "expect": {"json": [9007199254740993, 9007199254740992]},
      "jpx": {"args": ["orders[*].id"]},
      "python": {"code": "out([o['id'] for o in J()['orders']])"},
      "js": {"code": "out(J().orders.map(o=>o.id))", "known_failure": "js-number-precision", "known_result": {"json": [9007199254740992, 9007199254740992]}}
    },
    {
      "id": "large-id-compare",
      "category": "large-id",
      "intent": "Compare two adjacent ids above 2^53.",
      "data": "fixtures/orders.json",
      "profile": "standard",
      "preferred": "jpx",
      "expect": {"json": {"equal": false, "greater": true}},
      "jpx": {"args": ["{equal: orders[0].id == orders[1].id, greater: orders[0].id > orders[1].id}"], "known_failure": "#259", "known_result": {"json": {"equal": true, "greater": false}}},
      "python": {"code": "o=J()['orders'];out({'equal':o[0]['id']==o[1]['id'],'greater':o[0]['id']>o[1]['id']})"},
      "js": {"code": "const o=J().orders;out({equal:o[0].id===o[1].id,greater:o[0].id>o[1].id})", "known_failure": "js-number-precision", "known_result": {"json": {"equal": true, "greater": false}}}
    },
    {
      "id": "large-id-filter",
      "category": "large-id",
      "intent": "Select the order whose id is exactly 9007199254740993.",
      "data": "fixtures/orders.json",
      "profile": "standard",
      "preferred": "jpx",
      "expect": {"json": ["A-1"]},
      "jpx": {"args": ["orders[?id == `9007199254740993`].sku"], "known_failure": "#259", "known_result": {"json": ["A-1", "B-2"]}},
      "python": {"code": "out([o['sku'] for o in J()['orders'] if o['id']==9007199254740993])"},
      "js": {"code": "out(J().orders.filter(o=>o.id===9007199254740993).map(o=>o.sku))", "known_failure": "js-number-precision", "known_result": {"json": ["A-1", "B-2"]}}
