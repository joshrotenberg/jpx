    "docs": [
      "skills/jpx-functions/SKILL.md"
    ],
    "profile": "default",
    "input": "{}",
    "args": [
      "reduce_expr(&add(accumulator, current), `[1,2,3]`, `0`)"
    ],
    "expected": {
      "status": 0,
      "stdout": "6.0\n"
    }
  },
