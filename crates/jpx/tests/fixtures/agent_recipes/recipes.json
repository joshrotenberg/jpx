[
  {
    "id": "literal-array-function",
    "outcome": "A JSON literal in backticks is a real array, so unique() dedupes it regardless of input.",
    "docs": [
      "skills/jpx-functions/SKILL.md"
    ],
    "input": "{}",
    "args": [
      "unique(`[1,2,2,3]`)"
    ],
    "expected": {
      "status": 0,
      "stdout": "[1,2,3]\n"
    },
    "profile": "default"
  },
  {
    "id": "literal-object",
    "outcome": "A backtick JSON literal yields the object itself.",
    "docs": [
      "skills/jmespath-query/SKILL.md"
    ],
    "input": "{}",
    "args": [
      "`{\"a\":1}`"
    ],
    "expected": {
      "status": 0,
      "stdout": "{\"a\":1}\n"
    },
    "profile": "default"
  },
  {
    "id": "raw-string-literal",
    "outcome": "Single quotes inside the expression are a raw string literal, not a field name.",
    "docs": [
      "skills/jmespath-query/SKILL.md"
    ],
    "input": "{}",
    "args": [
      "'error'"
    ],
    "expected": {
      "status": 0,
      "stdout": "\"error\"\n"
    },
    "profile": "default"
  },
  {
    "id": "stream-select-errors",
    "outcome": "--stream evaluates each NDJSON line; null results are dropped, so only error records print.",
    "docs": [
      "skills/jpx-cli/SKILL.md",
      "skills/jpx-cli/references/streaming.md",
      "docs/src/cli/commands.md"
    ],
    "input": "{\"level\":\"info\",\"msg\":\"started\"}\n{\"level\":\"error\",\"msg\":\"disk full\"}\n{\"level\":\"info\",\"msg\":\"done\"}\n",
    "args": [
      "--stream",
      "if(level == 'error', @, `null`)"
    ],
    "expected": {
      "status": 0,
      "stdout": "{\"level\":\"error\",\"msg\":\"disk full\"}\n"
    },
    "profile": "default",
    "shell_args": "--stream \"if(level == 'error', @, \\`null\\`)\""
  },
  {
    "id": "stream-select-errors-none",
    "outcome": "When no line matches, --stream prints nothing and still exits 0.",
    "docs": [
      "docs/src/cli/working-with-files.md",
      "skills/jpx-cli/references/streaming.md"
    ],
    "input": "{\"level\":\"info\",\"msg\":\"started\"}\n{\"level\":\"info\",\"msg\":\"done\"}\n",
    "args": [
      "--stream",
      "if(level == 'error', @, `null`)"
    ],
    "expected": {
      "status": 0,
      "stdout": ""
    },
    "profile": "default"
  },
  {
    "id": "slurp-filter-errors",
    "outcome": "-s collects the same NDJSON into one array so a filter returns an array of matches.",
    "docs": [
      "docs/src/cli/working-with-files.md",
      "skills/jpx-cli/references/streaming.md"
    ],
    "input": "{\"level\":\"info\",\"msg\":\"started\"}\n{\"level\":\"error\",\"msg\":\"disk full\"}\n{\"level\":\"info\",\"msg\":\"done\"}\n",
    "args": [
      "-s",
      "[?level == 'error']"
    ],
    "expected": {
      "status": 0,
      "stdout": "[{\"level\":\"error\",\"msg\":\"disk full\"}]\n"
    },
    "profile": "default"
  },
  {
    "id": "exit-status-any-match",
    "outcome": "-x with a boolean predicate exits 0 when any item matches.",
    "docs": [
      "skills/jpx-cli/SKILL.md"
    ],
    "input": "[{\"id\":1,\"critical\":false},{\"id\":2,\"critical\":true}]",
    "args": [
      "-x",
      "length([?critical]) > `0`"
    ],
    "expected": {
      "status": 0,
      "stdout": "true\n"
    },
    "profile": "default",
    "shell_args": "-x 'length([?critical]) > `0`'"
  },
  {
    "id": "exit-status-no-match",
    "outcome": "-x with a boolean predicate prints false and exits 1 when nothing matches.",
    "docs": [
      "docs/src/cli/commands.md",
      "skills/jpx-cli/SKILL.md"
    ],
    "input": "[{\"id\":1,\"critical\":false}]",
    "args": [
      "-x",
      "length([?critical]) > `0`"
    ],
    "expected": {
      "status": 1,
      "stdout": "false\n"
    },
    "profile": "default"
  },
  {
    "id": "exit-status-empty-array-is-truthy",
