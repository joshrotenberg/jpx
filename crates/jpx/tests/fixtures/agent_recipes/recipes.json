  {
    "id": "unknown-function",
    "outcome": "An unknown function is an evaluation error: empty stdout, exit 1, and stderr suggests the near miss.",
    "docs": [
      "skills/jpx-functions/SKILL.md"
    ],
    "input": "[1,2]",
    "args": [
      "lenght(@)"
    ],
    "expected": {
      "status": 1,
      "stdout": "",
      "stderr_contains": "Did you mean"
    },
    "profile": "default"
  },
  {
    "id": "stream-slurp-conflict",
    "outcome": "--stream and -s are mutually exclusive; the usage error exits 2 and names the conflict.",
    "docs": [
      "skills/jpx-cli/references/streaming.md"
    ],
    "input": "{}\n",
    "args": [
      "--stream",
      "-s",
      "@"
    ],
    "expected": {
      "status": 2,
      "stdout": "",
      "stderr_contains": "cannot be used with"
    },
    "profile": "default"
  },
  {
