    "profile": "default-with-core-let"
  },
  {
    "id": "slurp-group-records",
    "outcome": "Aggregate NDJSON objects with slurp alone, grouping records by error type.",
    "docs": [
      "skills/jpx-cli/SKILL.md"
    ],
    "profile": "default",
    "input": "{\"error_type\":\"disk\",\"n\":1}\n{\"error_type\":\"net\",\"n\":2}\n{\"error_type\":\"disk\",\"n\":3}\n",
    "args": [
      "-s",
      "group_by(@, &error_type)"
    ],
    "shell_args": "-s 'group_by(@, &error_type)'",
    "expected": {
      "status": 0,
      "stdout": "{\"disk\":[{\"error_type\":\"disk\",\"n\":1},{\"error_type\":\"disk\",\"n\":3}],\"net\":[{\"error_type\":\"net\",\"n\":2}]}\n"
    }
  },
  {
    "id": "reduce-context",
